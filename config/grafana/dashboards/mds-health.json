      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"mds\"}[$__rate_interval]))",
