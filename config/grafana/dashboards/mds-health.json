        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{job=\"mds\",area=\"heap\"})",
          "legendFormat": "max",
          "range": true
