    {
      "id": 11,
      "type": "timeseries",
      "title": "GC and threads",
      "description": "Share of time spent in GC pauses (left) and live platform threads (right).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
