{
  "uid": "mds-prices",
  "title": "Prices: BTC/USD and ETH/USD",
  "description": "Last price of BTC/USD and ETH/USD per exchange, from the InfluxDB ticker measurement (README \"Dashboards\").",
  "tags": [
    "mds"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "mds dashboards",
      "type": "dashboards",
      "tags": [
        "mds"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "BTC/USD last price",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "description": "Latest last-trade price of BTC/USD on each exchange (ticker.last), within the past hour.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.exchange}",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"prices\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"last\" and r.pair == \"BTC/USD\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"exchange\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "ETH/USD last price",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "description": "Latest last-trade price of ETH/USD on each exchange (ticker.last), within the past hour.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.exchange}",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"prices\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"last\" and r.pair == \"ETH/USD\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"exchange\"])"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "BTC/USD last price by exchange",
      "description": "Last-trade price of BTC/USD (ticker.last) per exchange, as archived by mds every mds.archive.interval.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "lineWidth": 1
          },
          "decimals": 2,
          "displayName": "${__field.labels.exchange}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"prices\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"last\" and r.pair == \"BTC/USD\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"exchange\"])"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ETH/USD last price by exchange",
      "description": "Last-trade price of ETH/USD (ticker.last) per exchange, as archived by mds every mds.archive.interval.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "lineWidth": 1
          },
          "decimals": 2,
          "displayName": "${__field.labels.exchange}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"prices\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"last\" and r.pair == \"ETH/USD\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"exchange\"])"
        }
      ]
    }
  ]
}
