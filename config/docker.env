# mds settings for the mds container in docker-compose.yml (local development only); README "In
# Docker" explains each one. Any MDS_* variable from README "Configuration" can be added. Changes
# apply on the next `docker compose --profile app up -d`. Shell variables don't reach the container.

# InfluxDB on the compose network, by service name; the values match the influxdb service's
# DOCKER_INFLUXDB_INIT_* settings. The token is the local development default, not a secret.
MDS_INFLUX_URL=http://influxdb:8086
MDS_INFLUX_TOKEN=mds-dev-token
MDS_INFLUX_ORG=mds
MDS_INFLUX_BUCKET=prices

MDS_MODE=development
MDS_ENVIRONMENT=docker
# blank = readable text logs; ecs = JSON as in production
MDS_LOG_FORMAT=

# Uncomment to narrow what the container streams, or to use a SOCKS5 proxy on the host:
# MDS_EXCHANGES=kraken,bitstamp
# MDS_PAIRS=BTC/USDT,ETH/USDT
# MDS_SOCKS_PROXY_HOST=host.docker.internal
# MDS_SOCKS_PROXY_PORT=1080
